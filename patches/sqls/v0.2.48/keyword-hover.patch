+
+// languageIDDrivers maps Nova syntax names (languageId sent with
+// textDocument/didOpen) to sqls database drivers. Used when no database
+// connection is configured so keyword completions match the document's
+// dialect. Unmapped dialects fall back to coreKeywords.
+var languageIDDrivers = map[string]dialect.DatabaseDriver{
+	"mysql":      dialect.DatabaseDriverMySQL8,
+	"mariadb":    dialect.DatabaseDriverMySQL8,
+	"postgresql": dialect.DatabaseDriverPostgreSQL,
+	"tsql":       dialect.DatabaseDriverMssql,
+	"plsql":      dialect.DatabaseDriverOracle,
+	"sqlite":     dialect.DatabaseDriverSQLite3,
+	"h2":         dialect.DatabaseDriverH2,
+	"vertica":    dialect.DatabaseDriverVertica,
+	"clickhouse": dialect.DatabaseDriverClickhouse,
+}
