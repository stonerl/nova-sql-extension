diff --git a/internal/handler/keyword_hover.go b/internal/handler/keyword_hover.go
new file mode 100644
index 0000000..2806462
--- /dev/null
+++ b/internal/handler/keyword_hover.go
@@ -0,0 +1,156 @@
+package handler
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/sqls-server/sqls/ast"
+	"github.com/sqls-server/sqls/internal/lsp"
+	"github.com/sqls-server/sqls/token"
+)
+
+// findKeywordNode resolves the keyword (or multi-keyword phrase) under the
+// cursor. Returns the normalized uppercase keyword and the AST node used to
+// build the hover range. Non-keyword items (punctuation, operators, quoted
+// identifiers) are ignored. When allowIdentifier is set (no database
+// connected), unquoted identifiers that are dialect-specific keywords and
+// have curated docs are also accepted — with a database, real columns must
+// keep their DB hover.
+func findKeywordNode(nodes []ast.Node, allowIdentifier bool) (string, ast.Node) {
+	// Prefer the full multi-keyword phrase ("GROUP BY") over its parts.
+	for _, node := range nodes {
+		if node.Type() != ast.TypeMultiKeyword {
+			continue
+		}
+		words := strings.Fields(node.Render(&ast.RenderOptions{}))
+		if len(words) == 0 {
+			continue
+		}
+		return strings.ToUpper(strings.Join(words, " ")), node
+	}
+	for _, node := range nodes {
+		item, ok := node.(*ast.Item)
+		if !ok {
+			continue
+		}
+		if item.GetToken().Kind != token.SQLKeyword {
+			continue
+		}
+		return strings.ToUpper(item.String()), node
+	}
+	if !allowIdentifier {
+		return "", nil
+	}
+	// Dialect-specific keywords (e.g. RLIKE in MySQL) are not in sqls'
+	// core keyword table, so the lexer marks them Unmatched and the
+	// parser wraps them in Identifier nodes. Accept unquoted identifiers
+	// that are dialect keywords AND have curated documentation; quoted
+	// identifiers cannot collide.
+	for _, node := range nodes {
+		ident, ok := node.(*ast.Identifier)
+		if !ok {
+			continue
+		}
+		tok := ident.GetToken()
+		word, ok := tok.Value.(*token.SQLWord)
+		if !ok || word.QuoteStyle != 0 {
+			continue
+		}
+		upper := strings.ToUpper(word.Value)
+		if dialectKeywords[upper] {
+			if _, documented := keywordDocs[upper]; documented {
+				return upper, node
+			}
+		}
+	}
+	return "", nil
+}
+
+// keywordHover builds the Hover response for a documented keyword. The
+// documentation footer links are filtered by the document's dialect
+// (languageId from textDocument/didOpen).
+func keywordHover(node ast.Node, doc, kw, languageID string) *lsp.Hover {
+	content := doc
+	if footer := hoverLinksFooter(kw, languageID); footer != "" {
+		content += footer
+	}
+	return &lsp.Hover{
+		Contents: lsp.MarkupContent{
+			Kind:  lsp.Markdown,
+			Value: content,
+		},
+		Range: lsp.Range{
+			Start: lsp.Position{
+				Line:      node.Pos().Line,
+				Character: node.Pos().Col,
+			},
+			End: lsp.Position{
+				Line:      node.End().Line,
+				Character: node.End().Col,
+			},
+		},
+	}
+}
+
+// dialectVendor maps Nova languageIds (syntax names) to documentation
+// vendor keys used by keywordLinks.
+var dialectVendor = map[string]string{
+	"postgresql":  "postgres",
+	"mysql":       "mysql",
+	"mariadb":     "mariadb",
+	"tsql":        "tsql",
+	"sqlite":      "sqlite",
+	"plsql":       "oracle",
+	"snowflake":   "snowflake",
+	"bigquery":    "bigquery",
+	"trino":       "trino",
+	"flinksql":    "flink",
+	"hiveql":      "hive",
+	"sparksql":    "spark",
+	"redshift":    "redshift",
+	"singlestore": "singlestore",
+	"n1ql":        "couchbase",
+	"sqlpl":       "db2",
+}
+
+var dialectLabels = map[string]string{
+	"postgres":    "PostgreSQL",
+	"mysql":       "MySQL",
+	"mariadb":     "MariaDB",
+	"tsql":        "T-SQL (Microsoft)",
+	"sqlite":      "SQLite",
+	"oracle":      "Oracle",
+	"snowflake":   "Snowflake",
+	"bigquery":    "BigQuery (Google)",
+	"trino":       "Trino",
+	"flink":       "Flink SQL",
+	"hive":        "HiveQL",
+	"spark":       "Spark SQL",
+	"redshift":    "Redshift (AWS)",
+	"singlestore": "SingleStore",
+	"couchbase":   "N1QL (Couchbase)",
+	"db2":         "SQL PL (IBM DB2)",
+}
+
+// hoverLinksFooter renders the documentation link matching the document's
+// dialect (languageId from textDocument/didOpen). Generic SQL and dialects
+// without a curated page for the keyword show no footer — there is no
+// canonical standard-SQL reference to point at.
+func hoverLinksFooter(kw, languageID string) string {
+	links, ok := keywordLinks[kw]
+	if !ok || len(links) == 0 {
+		return ""
+	}
+
+	vendor, ok := dialectVendor[languageID]
+	if !ok {
+		// Generic SQL and unknown dialects: description only.
+		return ""
+	}
+	url, ok := links[vendor]
+	if !ok {
+		// Keyword not documented for this dialect.
+		return ""
+	}
+	return fmt.Sprintf("\n\nDocs: [%s: %s](%s)", dialectLabels[vendor], kw, url)
+}
